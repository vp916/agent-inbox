#!/usr/bin/python3
"""agent-inbox: talk to the agent-inbox daemon.

  agent-inbox status              one-shot list of sessions
  agent-inbox watch               live list
  agent-inbox toggle|show|hide    overlay visibility (bind `agent-inbox toggle` to a hotkey)
  agent-inbox view inbox|all|today  what the overlay lists (today = history of today's turns)
  agent-inbox screen [next|active|primary|<name>]  which screen the overlay opens on
                                  (active = the one you are working on); no argument lists them
  agent-inbox history             today's turns: when, project, how long, prompt, result
  agent-inbox dismiss [id]        clear "needs you" on one session (id prefix) or all
  agent-inbox approve|deny <id>   answer a permission prompt
  agent-inbox answer <id> <a>...  answer a question: one answer per part, an option (or its prefix) or any text
  agent-inbox focus <id>          bring that session's terminal window to the front
  agent-inbox stop <id>           end that session
  agent-inbox run <command...>    run any program under agent-inbox: it gets a card, a
                                  "waiting for input" alert, and can be typed into from the overlay
  agent-inbox type <id> <text>    type text + Enter into a program started with `run`
"""
import json
import os
import re
import select
import socket
import sys
import time

SOCK = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}") + "/agent-inbox.sock"
TTY = sys.stdout.isatty()
COLOR = {"permission": 33, "question": 33, "plan": 33, "done": 32, "error": 31, "working": 36, "idle": 90}
GLYPH = {"permission": "▲", "question": "▲", "plan": "▲", "done": "●", "error": "✗", "working": "◐", "idle": "○"}


def connect(first):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(SOCK)
    except OSError:
        sys.exit("daemon not running. Start it: systemctl --user start agent-inbox")
    s.sendall((json.dumps(first) + "\n").encode())
    return s


def ago(t):
    d = max(0, int(time.time() - t))
    return f"{d}s" if d < 60 else f"{d // 60}m" if d < 3600 else f"{d // 3600}h"


def render(snap):
    ui, out = snap["ui"], []
    for s in snap["sessions"]:
        a = s["attention"]
        kind = a["kind"] if a else s["state"]
        text = a["text"] if a else s["action"]
        since = a["ts"] if a else s["since"]
        line = f"{GLYPH[kind]} {s['project'][:24]:<24} {kind:<10} {text[:60]:<60} {ago(since):>4}  {s['entry'][:8]:<8} {s['id'][:8]}"
        out.append(f"\033[{COLOR[kind]}m{line}\033[0m" if TTY else line)
    need = sum(1 for s in snap["sessions"] if s["attention"])
    head = f"agents: {len(snap['sessions'])} open, {need} need you | overlay {'shown' if ui['visible'] else 'hidden'}, view {ui['view']}"
    lim = snap.get("limits") or {}
    use = [f"{n} {lim[k]['pct']}%" for k, n in (("five_hour", "5h"), ("seven_day", "7d")) if k in lim]
    if use:
        head += " | usage " + ", ".join(use)
    return "\n".join([head] + out)


ANSI = re.compile(r"\x1b\][^\x07\x1b]*(\x07|\x1b\\)|\x1b\[[0-?]*[ -/]*[@-~]|\x1b[@-_]|[\x00-\x08\x0b-\x1f\x7f]")
PROMPT = re.compile(
    r"(\?|:|>|\$|#|%|❯|›|»)\s*$|\[y/n\]|\(y/n\)|\(yes/no\)|press (enter|any key)|password|passphrase|\(esc\)|enter to (select|confirm)",
    re.I,
)


def run_terminal(argv):
    """Run a program on a pty we own: relay it to this terminal unchanged, report what it
    prints to the daemon, and type into it what the overlay sends."""
    import errno
    import fcntl
    import pty
    import signal
    import termios
    import tty
    from collections import deque

    if argv[:1] == ["--"]:
        argv = argv[1:]
    if not argv:
        sys.exit("usage: agent-inbox run <command> [args...]")
    try:
        with open((os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")) + "/agent-inbox/config.json") as f:
            idle = float(json.load(f).get("terminal_idle", 10))
    except (OSError, ValueError, AttributeError, TypeError):
        idle = 10.0
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(SOCK)
    except OSError:
        os.execvp(argv[0], argv)  # no daemon: just be the program
    sid = f"term-{os.getpid()}"
    sock.sendall((json.dumps({"kind": "terminal", "session": sid}) + "\n").encode())

    chain, p = [], os.getpid()
    while p > 1 and len(chain) < 12:
        chain.append(p)
        try:
            with open(f"/proc/{p}/stat") as f:
                p = int(f.read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            break
    base = {"session_id": sid, "cwd": os.getcwd(), "_agent": "terminal", "_pid": os.getpid(), "_chain": chain,
            "_entry": os.path.basename(argv[0])}  # fmt: skip

    def report(name, **fields):
        try:
            sock.sendall((json.dumps({**base, "hook_event_name": name, **fields}) + "\n").encode())
        except OSError:
            pass

    child, master = pty.fork()
    if child == 0:
        try:
            os.execvp(argv[0], argv)
        except OSError as e:
            os.write(2, f"agent-inbox: {argv[0]}: {e.strerror}\n".encode())
            os._exit(127)

    interactive = os.isatty(0)
    saved = termios.tcgetattr(0) if interactive else None

    def resize(*_):
        try:
            fcntl.ioctl(master, termios.TIOCSWINSZ, fcntl.ioctl(0, termios.TIOCGWINSZ, b"\0" * 8))
        except OSError:
            pass

    if interactive:
        tty.setraw(0)
        resize()
        signal.signal(signal.SIGWINCH, resize)

    report("SessionStart")
    report("UserPromptSubmit", prompt="$ " + " ".join(argv))
    lines, partial, typed, inbox = deque(maxlen=10), "", b"", b""
    last_out = sent_at = time.time()
    fresh = pending = False  # output not yet reported / output since the last Enter
    waiting = False
    sources = [master, sock] + ([0] if True else [])

    def feed(data):
        nonlocal partial
        text = partial + ANSI.sub("", data.decode("utf-8", "ignore").replace("\r\n", "\n"))
        *done, partial = text.split("\n")
        for line in done:
            line = line.rsplit("\r", 1)[-1].strip()
            if line and (not lines or lines[-1] != line):
                lines.append(line[:200])

    def last_line():
        cur = partial.rsplit("\r", 1)[-1].strip()
        return cur[:200] or (lines[-1] if lines else "")

    def to_program(data):
        nonlocal typed, pending, waiting
        while data:
            data = data[os.write(master, data):]

    def note_input(data):
        nonlocal typed, pending, waiting
        typed = (typed + data)[-300:]
        if b"\r" in data or b"\n" in data:
            try:
                echo = termios.tcgetattr(master)[3] & termios.ECHO
            except termios.error:
                echo = True
            text = ANSI.sub("", typed.decode("utf-8", "ignore")).strip()
            report("UserPromptSubmit", prompt=(text or "(enter)") if echo else "(hidden input)")
            typed, pending, waiting = b"", False, False

    try:
        while True:
            try:
                ready = select.select(sources, [], [], 0.5)[0]
            except InterruptedError:
                continue
            now = time.time()
            if master in ready:
                try:
                    data = os.read(master, 65536)
                except OSError as e:
                    if e.errno == errno.EIO:
                        break  # the program exited
                    raise
                if not data:
                    break
                os.write(1, data)
                feed(data)
                last_out, fresh, pending, waiting = now, True, True, False
            if 0 in ready:
                data = os.read(0, 4096)
                if data:
                    to_program(data)
                    note_input(data)
                else:
                    sources.remove(0)
            if sock in ready:
                chunk = sock.recv(65536)
                if not chunk:
                    sources.remove(sock)
                inbox += chunk
                *msgs, inbox = inbox.split(b"\n")
                for raw in msgs:
                    data = json.loads(raw).get("data", "").encode()
                    to_program(data)
                    note_input(data)
            if fresh and now - sent_at >= 1:
                report("Output", text=last_line())
                fresh, sent_at = False, now
            quiet = now - last_out
            if pending and not waiting and (quiet >= idle and PROMPT.search(last_line()) or quiet >= max(30, idle)):
                tail = list(lines) + ([partial.strip()[:200]] if partial.strip() else [])
                report("Waiting", text=last_line(), tail="\n".join(tail[-8:]), prompt_like=bool(PROMPT.search(last_line())))
                waiting = True
    finally:
        if saved:
            termios.tcsetattr(0, termios.TCSADRAIN, saved)
        report("SessionEnd")
    status = os.waitpid(child, 0)[1]
    sys.exit(os.waitstatus_to_exitcode(status) if hasattr(os, "waitstatus_to_exitcode") else status >> 8)


def main(a):
    cmd = a[0] if a else "status"
    if cmd == "run":
        run_terminal(a[1:])
    if cmd in ("-h", "--help", "help"):
        sys.exit(__doc__)
    if cmd == "watch":
        s = connect({"kind": "subscribe", "role": "watch"})
        f, snap = s.makefile(), None
        while True:
            if select.select([s], [], [], 1)[0]:
                line = f.readline()
                if not line:
                    sys.exit("daemon went away")
                snap = json.loads(line)
            if snap:
                print("\033[2J\033[H" + render(snap), flush=True)
    msg = {"kind": "cmd", "cmd": cmd}
    if cmd == "view":
        msg["view"] = a[1] if len(a) > 1 else ""
    elif cmd == "screen":
        msg["screen"] = a[1] if len(a) > 1 else ""
    elif len(a) > 1:
        msg["session"] = a[1]
        if cmd == "type":
            msg["text"] = " ".join(a[2:]) + "\r"
        elif len(a) > 2:
            msg["answers"] = a[2:]
    elif cmd in ("stop", "focus", "approve", "deny", "answer", "type"):
        sys.exit(f"usage: agent-inbox {cmd} <id>")
    reply = json.loads(connect(msg).makefile().readline())
    if reply["type"] == "error":
        sys.exit(reply["error"])
    if cmd == "status":
        print(render(reply))
    if cmd == "screen":
        ui = reply["ui"]
        print(f"overlay opens on: {ui['screen']}" + (f" (now on {ui['on']})" if ui.get("on") else ""))
        for name in ui.get("screens") or []:
            print(f"  {'*' if name == ui.get('on') else ' '} {name}")
        if not ui.get("screens"):
            print("  (screen list unknown: the overlay is not running)")
    if cmd == "history":
        for t in reversed(reply["turns"]):
            took = ago(time.time() - (t["end"] - t["start"])) if t["end"] else ("running" if t.get("live") else "unfinished")
            print(f"{time.strftime('%H:%M', time.localtime(t['start']))}  {t['project'][:22]:<22} {took:>10}  {t['tools']:>3} tools  {t['prompt']}")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        pass
